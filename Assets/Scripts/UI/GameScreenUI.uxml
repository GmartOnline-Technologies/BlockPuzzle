<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="MainContainer" style="flex-grow: 1; width: 100%; height: 100px; justify-content: space-between;">
        <ui:VisualElement name="TopBar" style="flex-grow: 1; flex-direction: column; justify-content: space-between;">
            <ui:Button text="Button" name="Btn_Back"/>
            <ui:VisualElement name="Key_Panel" style="flex-grow: 1;"/>
            <ui:VisualElement name="Coin_Panel" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="BottomContainer" style="flex-grow: 1;">
            <ui:VisualElement name="TrayBackground" style="flex-grow: 1; height: 250px;"/>
            <ui:VisualElement name="PowerUpBar" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <ui:Button text="Button" name="Btn_Hammer"/>
                <ui:Button text="Button" name="Btn_Rotate"/>
                <ui:Button text="Button" name="Btn_Undo"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BoardSpacer" style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
